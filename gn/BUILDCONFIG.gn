if (target_os == "") {
  target_os = host_os
}
if (target_cpu == "") {
  target_cpu = host_cpu
}
if (current_os == "") {
  current_os = target_os
}
if (current_cpu == "") {
  current_cpu = target_cpu
}

declare_args() {
  is_debug = false
}

if (target_os == "win") {
  set_default_toolchain("//gn:msvc")
} else if (target_os == "linux") {
  set_default_toolchain("//gn:gcc")
} else {
  assert(false, "This release build supports Windows and Linux only")
}
