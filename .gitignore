# ============================================================
# Whitelist mode: ONLY CMakeLists.txt, src/, .github/ workflows
# Images / dynamic libraries / executables / third-party
# vendored sources must NEVER enter the repository.
# ============================================================

# Deny everything first
*
!*/

# --- Explicit whitelist ---
!.github/**
!CMakeLists.txt
!.gitignore
!README.md
!LICENSE
!src/**
!webview2/
!webview2/.gitignore
!webview2/README.md
!webview2/readme.md
!webview2/build.bat
!webview2/start_clash_native.bat
!webview2/go.mod
!webview2/go.sum
!webview2/main.go
!webview2/mihomo-http-control.example.yaml
!webview2/ui/
!webview2/ui/**
!linux/
!linux/readme.md
!linux/config/
!linux/config/dnsmasq/
!linux/config/dnsmasq/*.conf
!linux/config/mihomo/
!linux/config/mihomo/*.yaml
!linux/config/sing-box/
!linux/config/sing-box/*.json
!linux/config/publish/
!linux/config/publish/sing-box/
!linux/config/publish/sing-box/*.json
!linux/config/systemd/
!linux/config/systemd/*.service

# --- Hard deny: executables, binaries, libraries ---
*.exe
*.dll
*.so
*.so.*
*.dylib
*.lib
*.exp
*.obj
*.o
*.a
*.pdb
*.ilk

# --- Hard deny: images ---
*.png
*.jpg
*.jpeg
*.bmp
*.gif
*.ico
*.tiff
*.tif
*.webp
*.svg
*.raw
*.psd

# --- Hard deny: archives / packages ---
*.zip
*.tar.gz
*.tar
*.7z
*.rar
*.msi

# --- Hard deny: third-party vendored (must come from network sources) ---
third_party/
vendor/
vendored/
deps/
external/

# --- Build output ---
build*/
out/
dist/
bin/
lib/

# --- IDE / OS / caches ---
.vs/
.vscode/
.idea/
*.user
*.suo
.DS_Store
Thumbs.db
*.log
logs/
cache/
__pycache__/
node_modules/
uploads/
output/
*.cfg
!codex_lan_agent.cfg
*.jsonl
!package.json
*.tmp
temp/
tmp/
*.dot
test_*_output*

# --- GN universal build pipeline whitelist (last-match-wins overrides build* deny) ---
!scripts/**
!build/
!build/*.args

# --- Temp trace output ---
src/temp_trace/
/src/tmp_logs

# --- Audit gateway / Clash runtime hard-deny ---
webview2/config.yaml
webview2/*.local.yaml
webview2/profiles/
webview2/providers/
webview2/cache.db
webview2/Country.mmdb
webview2/geoip.dat
webview2/geosite.dat
webview2/.tools/
linux/tmp_mihomo_deploy/
linux/config/logs/
linux/config/ssh/
linux/config/publish/kvm_delivery/
linux/config/publish/dnsmasq/
linux/config/publish/mihomo/
linux/config/**/*.key
linux/config/**/*_key*
linux/config/**/id_*
*.gz
*.zst
*.deb
*.rpm
*.pkg.tar.zst
