# ============================================================
# Whitelist mode: ONLY CMakeLists.txt, src/, .github/ workflows
# Images / dynamic libraries / executables / third-party
# vendored sources must NEVER enter the repository.
# ============================================================

# Deny everything first
*
!*/

# --- Explicit whitelist ---
!.github/**
!CMakeLists.txt
!.gitignore
!README.md
!LICENSE
!src/**

# --- Hard deny: executables, binaries, libraries ---
*.exe
*.dll
*.so
*.so.*
*.dylib
*.lib
*.exp
*.obj
*.o
*.a
*.pdb
*.ilk

# --- Hard deny: images ---
*.png
*.jpg
*.jpeg
*.bmp
*.gif
*.ico
*.tiff
*.tif
*.webp
*.svg
*.raw
*.psd

# --- Hard deny: archives / packages ---
*.zip
*.tar.gz
*.tar
*.7z
*.rar
*.msi

# --- Hard deny: third-party vendored (must come from network sources) ---
third_party/
vendor/
vendored/
deps/
external/

# --- Build output ---
build*/
out/
dist/
bin/
lib/

# --- IDE / OS / caches ---
.vs/
.vscode/
.idea/
*.user
*.suo
.DS_Store
Thumbs.db
*.log
logs/
cache/
__pycache__/
node_modules/
uploads/
output/
*.cfg
!codex_lan_agent.cfg
*.jsonl
!package.json
*.tmp
temp/
tmp/
*.dot
test_*_output*
